#!/usr/bin/env sh

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SKILL_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
RUNTIME="${MILES_RUNTIME_BINARY:-$HOME/.miles/bin/miles-runtime}"

if [ -x "$RUNTIME" ]; then
  MILES_HOME="${MILES_HOME-}" \
  MILES_SERVER_URL="${MILES_SERVER_URL-}" \
  MILES_PLUGIN_MANIFEST_URL="${MILES_PLUGIN_MANIFEST_URL-}" \
  MILES_PLUGIN_DOWNLOAD_URL="${MILES_PLUGIN_DOWNLOAD_URL-}" \
  MILES_PLUGIN_SOURCE="${MILES_PLUGIN_SOURCE-}" \
  WP_CLI="${WP_CLI-}" \
  MILES_SKILL_DIR="${MILES_SKILL_DIR:-$SKILL_DIR}" \
  MILES_CLI="${MILES_CLI:-$0}" \
  exec "$RUNTIME" "$@"
fi

if [ ! -f "$SCRIPT_DIR/miles-cli.mjs" ]; then
  echo "Miles CLI script not found: $SCRIPT_DIR/miles-cli.mjs" >&2
  exit 1
fi

if ! command -v node >/dev/null 2>&1; then
  echo "Miles CLI runtime not found: $RUNTIME" >&2
  echo "Install from start.bymiles.ai to get the bundled runtime, or install Node.js 20+ for the JavaScript fallback." >&2
  exit 1
fi

if [ ! -x "$SCRIPT_DIR/miles-cli.mjs" ]; then
  chmod +x "$SCRIPT_DIR/miles-cli.mjs" 2>/dev/null || {
    echo "Miles CLI script is not executable: $SCRIPT_DIR/miles-cli.mjs" >&2
    exit 1
  }
fi

MILES_HOME="${MILES_HOME-}" \
MILES_SERVER_URL="${MILES_SERVER_URL-}" \
MILES_PLUGIN_MANIFEST_URL="${MILES_PLUGIN_MANIFEST_URL-}" \
MILES_PLUGIN_DOWNLOAD_URL="${MILES_PLUGIN_DOWNLOAD_URL-}" \
MILES_PLUGIN_SOURCE="${MILES_PLUGIN_SOURCE-}" \
WP_CLI="${WP_CLI-}" \
MILES_SKILL_DIR="${MILES_SKILL_DIR:-$SKILL_DIR}" \
MILES_CLI="${MILES_CLI:-$0}" \
exec "$SCRIPT_DIR/miles-cli.mjs" "$@"
